<?xml version="1.0" encoding="UTF-8"?>

<Group>

	<ImportLibrary library='"torque\Debug\torque.dll"' />
	<ImportLibrary library='"vhtk.dll"' />
	<DeviceInfo>
	<!--	<HLHapticsDevice DEF="HAPD" positionCalibration="1e-3 0 0 0 0 1e-3 0 0 0 0 1e-3 0 0 0 0 1" > -->
<HLHapticsDevice DEF="HAPD" positionCalibration="0.0012 0 0 0 0 0.000848528137423857 -0.000848528137423857 -0.2 0 0.000848528137423857 0.000848528137423857 -0.1 0 0 0 1" orientationCalibration="1 0 0 0.785398163397448"> 
<!--		<HLHapticsDevice
			DEF="HAPD"
			positionCalibration="0.00221889675595 9.12440300453e-005 0.000210024314583 0.0250031687319
					8.65812544362e-005 0.000822421279736 -0.00202339026146 -0.14950978756
					-1.14950853458e-005 0.00266120722517 0.00207986799069 -0.741021752357
					0.0 0.0 0.0 1.0"
			orientationCalibration="-0.847518324852 0.351765632629 -0.397458732128 4.70526742935">
-->
			<Group containerField="stylus">
				<Transform translation="0.02 0 0">
					<Shape>
						<Appearance>
							<Material/>
						</Appearance>
						<!--<Sphere radius="0.005"/> -->
						<Box size="0.02 0.000001 0.02" />
					</Shape>
				</Transform>
				<Transform translation="0 0 0.08" rotation="1 0 0 1.570796" >
					<Shape>
						<Appearance>
							<Material/>
						</Appearance>
						<Cylinder radius="0.005" height="0.1"/>
					</Shape>
				</Transform>
			</Group>
		</HLHapticsDevice>
	</DeviceInfo>
    
	
<!--
	<Shape DEF="DATASHAPE"><Appearance>
		<Image3DTexture DEF="DATA_TEXTURE" url="exemple.raw"
			scaleToPowerOfTwo="TRUE"> 
		</Image3DTexture> 
	</Appearance></Shape>
-->

	<ForceTorqueField DEF="FF">
		<FieldedVectorImageVolume DEF="VECVOL">
<!--
				<VHTKImageObject
				containerField="imageObject"
				USE="DATA_TEXTURE" />
-->
			<VectorVolume  url="exemple.raw" containerField="imageObject">
				<RawImageLoader width="16" height="16" depth="16" bitsPerPixel="96"
					pixelType="VEC3" pixelComponentType="SIGNED"
					pixelSize="0.04 0.04 0.04" />
			</VectorVolume>
		</FieldedVectorImageVolume>	
	</ForceTorqueField>
<!--
	<VolumeHaptics>
		<VectorImageVolume DEF="VECVOL">
			<VHTKImageObject
				containerField="imageObject"
				USE="DATA_TEXTURE" />
		</VectorImageVolume>	
	</VolumeHaptics>
-->

	<PythonScript DEF="PS" url="test_raw.py">
		<ForceTorqueField USE="FF" containerField="references" />
		<HLHapticsDevice USE="HAPD" containerField="references" />
		<FieldedVectorImageVolume USE="VECVOL" containerField="references" />
	</PythonScript>

<!--
	<ROUTE fromNode="VECVOL" fromField="vector"
		toNode="PS" toField="vf" />
	<ROUTE fromNode="PS" fromField="calculated_force"
		toNode="FF" toField="force" />
	<ROUTE fromNode="HAPD" fromField="trackerOrientation"
		toNode="PS" toField="calculated_force" />
-->

</Group>
