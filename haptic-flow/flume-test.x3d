<?xml version="1.0" encoding="UTF-8"?>
<Group DEF="ROOT_GROUP"> 
	<DeviceInfo>
	<HLHapticsDevice DEF="HAPD" positionCalibration="0.00352976005524 5.59089785384e-005 0.000653294788208 0.123951092362 0.000233255006606 0.00180234899744 -0.00209078402258 -0.436432361603 -0.000420954573201 0.00348124792799 0.00176013680175 -0.774875462055 0.0 0.0 0.0 1.0" orientationCalibration="-0.852734744549 0.372199863195 -0.366484165192 5.11201334">

			<Group containerField="stylus">
				<Transform translation="0.01 0 0">
					<Shape>
						<Appearance>
							<Material/>
						</Appearance>
						<Box size="0.02 0.000001 0.02" />
					</Shape>
				</Transform>
				<Transform translation="0 0 0.08" rotation="1 0 0 1.570796" >
					<Shape>
						<Appearance>
							<Material/>
						</Appearance>
						<Cylinder radius="0.005" height="0.1"/>
					</Shape>
				</Transform>
			</Group>
		</HLHapticsDevice>
	</DeviceInfo>

<Transform translation="0 0 0" scale="0.7 0.7 0.7">
<!--
	<Shape>
		<Appearance>
			<Material/>
		</Appearance>
		<LineSet vertexCount="20">
			<Coordinate point="	 0.3  0.15  0.3
						 0.3  0.15 -0.3
						 0.3 -0.15 -0.3
