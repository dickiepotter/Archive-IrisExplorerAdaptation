<?xml version="1.0" encoding="UTF-8"?>

<Group>

	<ImportLibrary library='"vhtk.dll"' />
	<DeviceInfo>
	<!--	<HLHapticsDevice DEF="HAPD" positionCalibration="1e-3 0 0 0 0 1e-3 0 0 0 0 1e-3 0 0 0 0 1" > -->
<HLHapticsDevice DEF="HAPD" positionCalibration="0.0012 0 0 0 0 0.000848528137423857 -0.000848528137423857 -0.2 0 0.000848528137423857 0.000848528137423857 -0.1 0 0 0 1" orientationCalibration="1 0 0 0.785398163397448">
			<Group containerField="stylus">
				<!--<Transform translation="0.02 0 0">-->
					<Shape>
						<Appearance>
							<Material/>
						</Appearance>
						<Sphere radius="0.005"/>
						<!--<Box size="0.02 0.000001 0.02" />-->
					</Shape>
				<!--</Transform> -->
				<Transform translation="0 0 0.08" rotation="1 0 0 1.570796" >
					<Shape>
						<Appearance>
							<Material/>
						</Appearance>
						<Cylinder radius="0.005" height="0.1"/>
					</Shape>
				</Transform>
			</Group>
		</HLHapticsDevice>
	</DeviceInfo>


<!--
	<VolumeProbe DEF="probe">
		<VectorVolume USE="VOL" containerField="vectorVolume" />
	</VolumeProbe>
-->

    

	<PythonScript url="test_vis.py" DEF="ConvPS" />
	<PythonScript url="PutStreamRibbons.py" DEF="PUT">
		<Group containerField="references" />
		<Appearance containerField="references" />
		<StreamRibbons DEF="VIS" containerField="references">
			<VectorElectroPotential DEF="VOL" point="0 0 0" potential="1" containerField="vectorVolume" />
		</StreamRibbons>
	</PythonScript>
	<Shape>
		<Sphere radius="0.2" />
	</Shape>
	<VectorForceMode>
		<VectorVolume USE="VOL" containerField="vectorVolume" />
		<WindowFunction containerField="strength" />
	</VectorForceMode>
	<LocalInfo DEF="INFO" />
<!--
	<PythonScript url="test_torque.py">
		<ForceTorqueField USE="FF" containerField="references" />
		<HLHapticsDevice USE="HAPD" containerField="references" />
	</PythonScript>
-->

<!--	<ROUTE fromNode="HAPD" fromField="trackerPosition"
		toNode="probe" toField="probe" />
-->
	<KeySensor DEF="KEYBOARD" />

	<ROUTE fromNode="KEYBOARD" fromField="isActive"
		toNode="PUT" toField="putStreamRibbons" />
	<ROUTE fromNode="HAPD" fromField="trackerPosition"
		toNode="INFO" toField="position" />
	<ROUTE fromNode="INFO" fromField="position"
		toNode="PUT" toField="putStreamRibbons" />

<!--
	<ROUTE fromNode="HAPD" fromField="trackerPosition"
		toNode="ConvPS" toField="convertor" />

	<ROUTE fromNode="ConvPS" fromField="convertor"
		toNode="VIS" toField="source" />
-->

<!--
	<ROUTE fromNode="PS" fromField="calculated_force"
		toNode="FF" toField="force" />
	<ROUTE fromNode="HAPD" fromField="trackerOrientation"
		toNode="PS" toField="calculated_force" />
-->

</Group>
