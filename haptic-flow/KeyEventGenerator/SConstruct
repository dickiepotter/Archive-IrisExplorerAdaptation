#!/usr/bin/python
# copied/modified from Olivier Tilloy's SConstruct

import os.path
import os

env = Environment()

# define a preprocessor variable according to the system type (eg. #define POSIX, WIN32...)
env.Append(CPPDEFINES = env['PLATFORM'].upper())

# special flags for MSVC compiler (cl.exe) : /GR (RTTI bug), /EHsc (C++ exceptions)
visualcpp_flags = ['/GR', '/EHsc', '/MD', '/Zi']

if env['PLATFORM'] == 'win32' and env.subst(env['CXX']) == 'cl':
	env.Append(CCFLAGS = visualcpp_flags)
else:
	env.Append(CCFLAGS = ["-g",  "-Wall"])

h3d_libs = Split('H3DApi freeimage')


if env['PLATFORM'] == 'posix':
	h3d_home = '/home/guijemont/src'
	h3d_libs_dirs = [ os.path.join(h3d_home,'H3DAPI/build/linux'), '/home/guijemont/src/FreeImage/Dist' ]
	h3d_libs = h3d_libs + Split('freetype ftgl freeimage')
	h3d_inc_dirs = Split('/usr/include/FTGL /usr/include/freetype2 /home/guijemont/src/FreeImage/Dist')
	vhtk_home = '/home/guijemont/src/VHTK'
elif env['PLATFORM'] == 'win32':
	h3d_home = 'C:\\H3D'
	h3d_libs_dirs = Split(h3d_home + '\\H3DAPI\\build\\win32\\vc7\\Release ' + h3d_home + '\\External\\lib')
	h3d_libs = h3d_libs + Split('freetype219MT ftgl_static_MTD')
	h3d_inc_dirs = ['C:\\Program Files\\SensAble\\3DTouch\\include', h3d_home + '\\External\\include', h3d_home + '\\External\\include\\FTGL\\include', h3d_home + '\\External\\include\\freetype-2.1.9\\include', h3d_home + '\\External\\include\\xerces-c-src_2_7_0\\src', h3d_home + '\\External\\include\\pthread']

h3d_inc_dirs = h3d_inc_dirs + [os.path.join(h3d_home, 'H3DAPI', 'src'), os.path.join(h3d_home, 'H3DAPI', 'src', 'Types')]



#env_h3d = env.Copy()

env.Append(CPPPATH = h3d_inc_dirs)
env.Append(LIBPATH = h3d_libs_dirs)
env.Append(LIBS = h3d_libs)


src = []
src += ["KeyEventGenerator.cpp"]
src += ["IntUpdater.cpp"]
src += ["FloatUpdater.cpp"]
#src += ["Updater.cpp"]
env.SharedLibrary('keg', source = src)
