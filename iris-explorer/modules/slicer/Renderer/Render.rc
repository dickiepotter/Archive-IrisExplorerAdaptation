/////////////////////////////////////////////////////////////////////////////
//
// Toolbar
//

IDR_MAINFRAME TOOLBAR DISCARDABLE  16, 15
BEGIN
    BUTTON      ID_FILE_SAVE
    SEPARATOR
    BUTTON      ID_EDIT_COPY
    SEPARATOR
    BUTTON      ID_FILE_PRINT
    BUTTON      ID_APP_ABOUT
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Save\tCtrl+S",               ID_FILE_SAVE
        MENUITEM "Save &As...",                 ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "&Print...\tCtrl+P",           ID_FILE_PRINT
        MENUITEM "Print Pre&view",              ID_FILE_PRINT_PREVIEW
        MENUITEM "P&rint Setup...",             ID_FILE_PRINT_SETUP
        MENUITEM "Print &Background",           ID_FILE_PRINT_BACKGROUND
        MENUITEM SEPARATOR
        MENUITEM "&About Render...",            ID_APP_ABOUT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "Pick &All\tCtrl+A",           ID_EDIT_PICKALL
        MENUITEM "Pick Pa&rent\tCtrl+P",        ID_EDIT_PICKPARENT
        MENUITEM SEPARATOR
        MENUITEM "Enable",                      ID_SELECTION_ENABLE
        MENUITEM "Single Selection",            ID_SELECTION_SINGLESELECTION
        MENUITEM "Toggle Selection",            ID_SELECTION_TOGGLESELECTION
        MENUITEM "Shift Selection",             ID_SELECTION_SHIFTSELECTION
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "Viewing",                     ID_VIEW_PICEDIT
        MENUITEM "User Pick Mode",              ID_VIEW_USERPICKMODE
        MENUITEM SEPARATOR
        MENUITEM "Examiner",                    ID_VIEW_EXAMINER
        MENUITEM "Fly",                         ID_VIEW_FLY
        MENUITEM "Walk",                        ID_VIEW_WALK
        MENUITEM "Plane",                       ID_VIEW_PLANE
        MENUITEM SEPARATOR
        MENUITEM "View Selection",              ID_VIEW_VIEWSELECTION
        MENUITEM "Fog",                         ID_VIEW_FOG
        MENUITEM "Antialiasing",                ID_VIEW_ANTIALIASING
        MENUITEM SEPARATOR
        MENUITEM "Screen Door Transparency",    ID_VIEW_SCREENDOORTRANSPARENCY

        MENUITEM "Blended Transparency",        ID_VIEW_BLENDEDTRANSPARENCY
        MENUITEM "Delayed Blended Transparency", 
                                                ID_VIEW_DELAYEDBLENDEDTRANSPARENCY

        MENUITEM "Sorted Blended Transparency", ID_VIEW_SORTEDBLENDEDTRANSPARENCY

        MENUITEM SEPARATOR
        MENUITEM "Edit Background Color...",    ID_VIEW_EDITBACKGROUNDCOLOR
    END
    POPUP "E&ditors"
    BEGIN
        MENUITEM "Enable",                      ID_SELECTION_ENABLE
        MENUITEM "&Material Editor...",         ID_EDITORS_MATERIALEDITOR
        MENUITEM "&Color Editor...",            ID_EDITORS_COLOREDITOR
        MENUITEM "&Transform Sliders...",       ID_EDITORS_TRANSFORMSLIDERS
    END
    POPUP "&Manips"
    BEGIN
        MENUITEM "&Trackball",                  ID_MANIPS_TRACKBALL
        MENUITEM "&HandleBox",                  ID_MANIPS_HANDLEBOX
        MENUITEM "&Jack",                       ID_MANIPS_JACK
        MENUITEM "&Centerball",                 ID_MANIPS_CENTERBALL
        MENUITEM "Trans&formBox",               ID_MANIPS_TRANSFORMBOX
        MENUITEM "Ta&bBox",                     ID_MANIPS_TABBOX
        MENUITEM "&Universal Transform",        ID_MANIPS_UTRANSFORM
        MENUITEM "&None",                       ID_MANIPS_NONE
        MENUITEM SEPARATOR
        MENUITEM "&Replace",                    ID_MANIPS_REPLACE
    END
    POPUP "&Lights"
    BEGIN
        MENUITEM "Create &Dir Light",           ID_LIGHTS_CREATEDIRLIGHT
        MENUITEM "Create &Point Light",         ID_LIGHTS_CREATEPOINTLIGHT
        MENUITEM "Create &Spot Light",          ID_LIGHTS_CREATESPOTLIGHT
        MENUITEM SEPARATOR
        MENUITEM "&Ambient Lighting...",        ID_LIGHTS_AMBIENTLIGHTING
        MENUITEM SEPARATOR
        MENUITEM "Turn all &ON",                ID_LIGHTS_TURNALLON
        MENUITEM "Turn all O&FF",               ID_LIGHTS_TURNALLOFF
        MENUITEM "Show all Icons",              ID_LIGHTS_SHOWALLICONS
        MENUITEM "Hide all Icons",              ID_LIGHTS_HIDEALLICONS
        MENUITEM SEPARATOR
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_MAINFRAME ACCELERATORS PRELOAD MOVEABLE PURE 
BEGIN
    "A",            ID_EDIT_PICKALL,        VIRTKEY, CONTROL, NOINVERT
    "C",            ID_EDIT_COPY,           VIRTKEY, CONTROL, NOINVERT
    "N",            ID_FILE_NEW,            VIRTKEY, CONTROL, NOINVERT
    "O",            ID_FILE_OPEN,           VIRTKEY, CONTROL, NOINVERT
    "P",            ID_FILE_PRINT,          VIRTKEY, CONTROL, NOINVERT
    "R",            ID_EDIT_PICKPARENT,     VIRTKEY, CONTROL, NOINVERT
    "S",            ID_FILE_SAVE,           VIRTKEY, CONTROL, NOINVERT
    "V",            ID_EDIT_PASTE,          VIRTKEY, CONTROL, NOINVERT
    VK_BACK,        ID_EDIT_UNDO,           VIRTKEY, ALT, NOINVERT
    VK_DELETE,      ID_EDIT_CUT,            VIRTKEY, SHIFT, NOINVERT
    VK_F6,          ID_NEXT_PANE,           VIRTKEY, NOINVERT
    VK_F6,          ID_PREV_PANE,           VIRTKEY, SHIFT, NOINVERT
    VK_INSERT,      ID_EDIT_COPY,           VIRTKEY, CONTROL, NOINVERT
    VK_INSERT,      ID_EDIT_PASTE,          VIRTKEY, SHIFT, NOINVERT
    "X",            ID_EDIT_CUT,            VIRTKEY, CONTROL, NOINVERT
    "Z",            ID_EDIT_UNDO,           VIRTKEY, CONTROL, NOINVERT
END


